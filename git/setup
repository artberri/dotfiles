#!/usr/bin/env bash
#
# - Make sure ~/.gitconfig exists, so `git config --global` (and tools that
#   use it) write there instead of into the linked ~/.config/git/config.
# - Install delta, the pager configured in gitconfig.

set -euo pipefail

if [ ! -e "$HOME/.gitconfig" ]; then
	echo "  Creating empty ~/.gitconfig"
	printf '# Machine-specific git config (email, includeIf…). Overrides ~/.config/git/config.\n' >"$HOME/.gitconfig"
fi

if command -v delta >/dev/null 2>&1; then
	echo "  delta already installed"
elif [ "$DOTFILES_OS" = macos ] && command -v brew >/dev/null 2>&1; then
	echo "  brew install git-delta"
	brew install git-delta
else
	echo "  delta not found; git diffs will fail until it is installed:" >&2
	echo "  https://dandavison.github.io/delta/installation.html" >&2
fi
