# Default editor settings for files under $HOME, linked to ~/.editorconfig.
# A project's own .editorconfig wins for its files. https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# Two trailing spaces are a line break in Markdown
[*.{md,markdown}]
trim_trailing_whitespace = false

# Tabs aren't allowed for indentation in YAML
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Windows scripts expect CRLF
[*.{bat,cmd,ps1}]
end_of_line = crlf
