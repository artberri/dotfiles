#!/usr/bin/env bash
#
# - Make ~/.bashrc load ~/.extend.bashrc (and ~/.bash_profile load ~/.bashrc).
# - Install starship on Linux if apt didn't have it.
# - Make an up-to-date bash the login shell. On macOS that means Homebrew's
#   bash, since /bin/bash is stuck at 3.2.
#
# ~/.bashrc and ~/.bash_profile stay regular files owned by the machine, so
# tool installers can append to them without touching this repo.

set -euo pipefail

# Append a line to a file unless a line containing `marker` is already there.
ensure_line() {
	local file="$1" marker="$2" line="$3"
	if [ -f "$file" ] && grep -qF "$marker" "$file"; then
		return
	fi
	echo "  Adding to ~/${file#"$HOME"/}: $line"
	if [ -s "$file" ] && [ -n "$(tail -c 1 "$file")" ]; then
		echo >>"$file"
	fi
	printf '\n%s\n' "$line" >>"$file"
}

ensure_line "$HOME/.bashrc" ".extend.bashrc" \
	'[ -f "$HOME/.extend.bashrc" ] && . "$HOME/.extend.bashrc"'
# Login shells (macOS terminals, SSH) read ~/.bash_profile, not ~/.bashrc.
# On Linux, don't create one if missing: it would shadow the distro's
# ~/.profile, which already loads ~/.bashrc.
if [ -f "$HOME/.bash_profile" ] || [ "$DOTFILES_OS" = macos ]; then
	ensure_line "$HOME/.bash_profile" "/.bashrc" \
		'[ -f "$HOME/.bashrc" ] && . "$HOME/.bashrc"'
fi

# starship isn't in apt on some releases (e.g. Ubuntu 24.04): use its
# official installer, into ~/.local/bin so it needs no sudo.
if ! command -v starship >/dev/null 2>&1 && [ "$DOTFILES_OS" = linux ]; then
	if command -v curl >/dev/null 2>&1; then
		echo "  Installing starship with its official installer into ~/.local/bin"
		mkdir -p "$HOME/.local/bin"
		curl -fsSL https://starship.rs/install.sh | sh -s -- --yes --bin-dir "$HOME/.local/bin" >/dev/null
	else
		echo "  starship not installed and curl is missing; skipping" >&2
	fi
fi

if [ "$DOTFILES_OS" = macos ]; then
	# Homebrew's bash is installed by ./install (bash/packages).
	brew_prefix=
	for prefix in /opt/homebrew /usr/local; do
		if [ -x "$prefix/bin/brew" ]; then
			brew_prefix="$prefix"
			break
		fi
	done
	bash_path="$brew_prefix/bin/bash"
	if [ -z "$brew_prefix" ] || [ ! -x "$bash_path" ]; then
		echo "  Homebrew's bash not found; run ./install without --no-packages. Login shell unchanged." >&2
		exit 0
	fi
	current_shell="$(dscl . -read "/Users/$(id -un)" UserShell | awk '{print $2}')"
else
	current_shell="$(getent passwd "$(id -un)" | cut -d: -f7)"
	# Any bash will do: /bin/bash and /usr/bin/bash are the same file on
	# merged-/usr distros, so don't compare paths.
	case "$current_shell" in
	*/bash)
		echo "  Login shell is already $current_shell"
		exit 0
		;;
	esac
	if grep -qxF /bin/bash /etc/shells; then
		bash_path=/bin/bash
	else
		bash_path="$(command -v bash)"
	fi
fi

if ! grep -qxF "$bash_path" /etc/shells; then
	echo "  Adding $bash_path to /etc/shells (needs sudo)"
	echo "$bash_path" | sudo tee -a /etc/shells >/dev/null
fi

if [ "$current_shell" != "$bash_path" ]; then
	echo "  Changing login shell to $bash_path"
	chsh -s "$bash_path"
	echo "  Done. Open a new terminal to start using it."
else
	echo "  Login shell is already $bash_path"
fi
